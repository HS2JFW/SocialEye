# LiteLLM AI Gateway Configuration
LITELLM_ENDPOINT=https://llm.addpay.in.th/v1
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_MODEL=gemma-4-31b-it
LITELLM_EMBEDDING_MODEL=embeded

# Coolify Integration
COOLIFY_API_TOKEN=your_coolify_api_token_here

# Database & Redis (defaults for docker-compose)
DATABASE_URL=postgresql+asyncpg://socialeye:socialeye_secret@postgres:5432/socialeye
REDIS_URL=redis://redis:6379/0

# App Settings
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret_in_production
ALLOWED_ORIGINS=https://socialeye.addpay.in.th,http://localhost:3000
